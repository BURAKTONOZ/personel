name: Build Windows EXE

on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  build:
    runs-on: windows-latest

    steps:
    - name: Kodu İndir
      uses: actions/checkout@v3

    - name: Node.js Kurulumu
      uses: actions/setup-node@v3
      with:
        node-version: 18

    - name: Gerekli Paketleri Yükle
      run: npm install

    - name: Exe Dosyasını Derle
      run: npm run build

    - name: Exe Dosyasını Çıktı Olarak Ver
      uses: actions/upload-artifact@v3
      with:
        name: Numarataj-Personel-Uygulamasi
        path: dist/*.exe
